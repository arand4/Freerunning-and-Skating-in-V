+/// How far through its clip a ladder step is. Faith Runner V: climbing up faster than Mirror's
+/// Edge (Tuning::ladder_climb_speed s), the arms only speed up by sqrt(s), so a quick climb
+/// doesn't look frantic: each step shows most of the reach (1 / sqrt(s) of the clip).
+fn climb_clip_progress(c: &Controller, m: &faith_move::ClimbStep) -> f32 {
+    let k = (m.t / m.dur.max(1e-3)).clamp(0.0, 1.0);
+    let s = c.tuning.ladder_climb_speed;
+    if m.down || s <= 1.0 { k } else { (k / s.sqrt()).min(1.0) }
+}
