+/// Faith Runner V: whether a crouched body fits across from above `from` to above `to`, just
+/// over a lip at height `lip`.
+pub fn clear_over_lip(world: &dyn World, body: Body, from: Vec3, to: Vec3, lip: f32, crouch_height: f32) -> bool {
+    let half = Vec3::new(body.half_width * 0.9, crouch_height * 0.45, body.half_width * 0.9);
+    let y = lip + 0.03 + half.y;
+    let a = Vec3::new(from.x, y, from.z);
+    let b = Vec3::new(to.x, y, to.z);
+    // A roof sloping up from the lip is fine: only a steep face (a wall) is in the way.
+    (b - a).length() < 1e-4 || world.sweep(half, a, b - a).is_none_or(|h| h.normal.y >= 0.7)
+}
